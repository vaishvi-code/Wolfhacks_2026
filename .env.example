PORT=4173
HOST=127.0.0.1
# Demo uses real OpenStreetMap streets and locations with simulated conditions.
# Set synthetic for an entirely fictional, network-free demo.
DEMO_ROADS=real
# Optional Gemini bonus. Never put keys in public/ or commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# A descriptive identifier for public data providers; add your contact if deploying.
DATA_USER_AGENT=WayAhead/0.1 (hackathon geospatial prototype)

# Optional Census county population context (ACS 2024 5-year estimates).
CENSUS_API_KEY=
# Optional Data.gov catalog discovery (metadata, not measurements).
DATA_GOV_API_KEY=
# Optional ElevenLabs bonus. Use a voice available in your account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional Tiger Data bonus. Requires npm install (pg driver).
# Use the TLS-enabled connection string from your Tiger Cloud dashboard.
TIGER_DATABASE_URL=
# Optional bridge YOU deploy to ingest batches into a Databricks-backed pipeline.
# This is not a built-in Databricks endpoint. See docs/INTEGRATIONS.md.
DATABRICKS_INGEST_URL=
DATABRICKS_INGEST_TOKEN=
# Polling is clamped to a minimum of 60 seconds.
POLL_MS=60000
