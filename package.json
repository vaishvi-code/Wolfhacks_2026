{
  "name": "wayahead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "North Carolina hurricane, flood and heat response planning with public geospatial data",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:live": "node --env-file-if-exists=.env scripts/check-live.mjs",
    "check:apis": "node --env-file-if-exists=.env scripts/check-apis.mjs"
  },
  "optionalDependencies": { "pg": "^8.16.3" }
}
